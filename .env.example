# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/ai_lesson_generator

# Centralized LLM Gateway (Groq API)
# Base URL for Groq inference (OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Free GPT OSS models available on Groq:
#  - openai/gpt-oss-120b (recommended, powerful)
#  - openai/gpt-oss-20b (fast, lightweight)
GROQ_MODEL=openai/gpt-oss-120b

# Primary Groq API Key (starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Multiple keys for automatic failover & rate limit prevention
# GROQ_API_KEY_1=gsk_first_key
# GROQ_API_KEY_2=gsk_second_key
# GROQ_API_KEY_3=gsk_third_key

# Research Provider API Keys (Optional - if missing or failing, system hallucinate data as instructed)
BRAVE_SEARCH_API_KEY=
GOOGLE_BOOKS_API_KEY=
YOUTUBE_API_KEY=

# Supervisor Settings
SUPERVISOR_MAX_ITERATIONS=3
